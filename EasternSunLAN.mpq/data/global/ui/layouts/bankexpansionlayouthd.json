                "textColor": "$FontColorLightGold",
                "tooltipString": "This allows you to switch between multiple pages of shared stash tabs",
                "tooltipStyle": {
                    "showAfterDelay": true
                }
            }
        },
        {
            "type": "TabBarWidget",
            "name": "BankTabs",
            "fields": {
                "rect": {
                    "x": 82,
                    "y": 160
                },
                "tabCount": 8,
                "filename": "PANEL\\stash\\Stash_Tabs_Blank",
                "inactiveFrames": [
                    0,
                    0,
                    0,
                    0,
                    0,
                    0,
