{
    "basedOn": "BankOriginalLayoutHD.json",
    "type": "BankPanel",
    "name": "BankExpansionLayout",
    "children": [
        {
            "type": "ClickCatcherWidget",
            "name": "click_catcher"
        },
        {
            "type": "ImageWidget",
            "name": "background",
            "fields": {
                "filename": "PANEL\\Stash\\StashPanel_BG2"
            }
        },
        {
            "type": "ImageWidget",
            "name": "LeftSprite"
        },
        {
            "type": "ImageWidget",
            "name": "LeftHinge"
        },
        {
            "type": "TextBoxWidget",
            "name": "title"
        },
        {
            "type": "TextBoxWidget",
            "name": "gold_amount"
        },
        {
            "type": "ButtonWidget",
            "name": "gold_withdraw"
        },
        {
            "type": "ButtonWidget",
            "name": "close"
        },
        {
