                        "alwaysAcceptsKeyInput": true,
                        "fontStyle": {
                            "fontColor": {
                                "r": 255,
                                "g": 255,
                                "b": 255,
                                "a": 255
                            },
                            "pointSize": "$MediumFontSize",
                            "fontFace": "BlizzardGlobal",
                            "alignment": {
                                "h": "left",
                                "v": "center"
                            },
                            "options": {
                                "pipeCharacterBehavior": "handle"
                            }
                        },
                        "backgroundColor": [
                            0.05,
                            0.03,
                            0.02,
                            1.0
                        ],
                        "text/rect": {
                            "x": 20,
                            "width": 440,
                            "height": 50
                        },
                        "maxStringLength": 15
                    }
                }
            ]
        }
